# 飞牛实际路径；容器内保持相同绝对路径
ORCA_PROJECTS_PATH=/vol1/1000/docker
# 独立备份目录，不可放进被管理项目
ORCA_BACKUPS_PATH=/vol1/1000/orca-backups
# 仅数据库没有管理员时用于首次初始化；之后在账户设置中改密
ORCA_ADMIN_USER=admin
ORCA_ADMIN_PASSWORD=replace-with-a-long-random-password
# 内网访问时改为飞牛内网 IP；本机反向代理可保留 127.0.0.1
ORCA_BIND_ADDRESS=127.0.0.1
ORCA_PORT=7788
